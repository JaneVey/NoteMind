# ============================================================
# NoteMind 环境变量模板
#
# 用法：
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)
#   然后填入真实值
#
# 说明：
#   - .env 已被 .gitignore 忽略，不会提交到仓库
#   - Spring Boot 启动时会自动加载（见 application.yml 的 spring.config.import）
#   - 也可以在 IDEA 的 Run Configuration → Environment variables 里直接设置
#     环境变量优先级高于 .env 文件
# ============================================================

# ------------------------------------------------------------
# 数据库（PostgreSQL 16 + pgvector）
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notemind
DB_USERNAME=postgres
DB_PASSWORD=123456

# ------------------------------------------------------------
# Redis
#
# ⚠️ 端口用 6380 而非默认的 6379，原因：
#    本机 6379 上跑着一个 Windows 服务形式的 Redis 3.0.504（2015 年微软移植版），
#    且其中存有另一个项目（若依系，sys_dict:* 前缀）的数据，不能停用。
#    NoteMind 使用 Docker 中的 redis:7-alpine（与部署环境版本一致），
#    映射到 host 6380 以避开冲突。
#
#    注意：在 docker compose 内部运行的 app 服务不使用本项，
#    它通过服务名直连 redis:6379（见 docker-compose.yml 的 app 环境变量）。
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ------------------------------------------------------------
# MinIO 对象存储
# 本地开发若用 docker compose，端点保持 http://localhost:9000
# 容器内运行后端时改为 http://minio:9000
# ------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=notemind

# ------------------------------------------------------------
# JWT
# 生产环境必须替换为随机长字符串（至少 32 字节 = 256 位）
# 生成示例：openssl rand -base64 48
# ------------------------------------------------------------
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long

# ------------------------------------------------------------
# AI 服务
#
# 说明：这里的配置是【后端启动兜底值】，仅用于最小链路验证。
#      系统的正式行为是从数据库 ai_config 表按用户读取配置，
#      在运行时以编程方式构建 ChatModel / EmbeddingModel，
#      因此用户可以在前端设置页填入任意 OpenAI 兼容服务。
#
# 开发阶段推荐：硅基流动（一个 Key 同时覆盖 chat / embedding / rerank）
#   控制台：https://cloud.siliconflow.cn   模型列表见控制台「模型广场」
#   ⚠️ 模型 ID 必须与控制台显示的完全一致，含厂商前缀（如 BAAI/bge-m3）
# ------------------------------------------------------------
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=BAAI/bge-m3

# Embedding 输出维度。必须与 init.sql 的 VECTOR(1024) 一致。
# 更换向量模型会使已有向量全部作废，需重新解析全部文档。
AI_EMBEDDING_DIMENSION=1024

# ------------------------------------------------------------
# CORS 允许的来源（前端地址），多个用英文逗号分隔
# 生产环境必须改为真实域名，不要使用 *
# ------------------------------------------------------------
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
